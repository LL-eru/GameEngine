<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <GLFWRoot>C:\GLFW\glfw-3.4</GLFWRoot>
    <GLFWSharedLibDir>$(GLFWRoot)\build-shared\src\$(Configuration)</GLFWSharedLibDir>
    <GLFWDll>$(GLFWSharedLibDir)\glfw3.dll</GLFWDll>
    <InterfaceDir>$(SolutionDir)Interface</InterfaceDir>
    <VulkanSDK14 Condition="'$(VULKAN_SDK)' != ''">$(VULKAN_SDK)</VulkanSDK14>
    <VulkanSDK14 Condition="'$(VulkanSDK14)' == ''">$(VULKAN_SDK)</VulkanSDK14>
  </PropertyGroup>
</Project>
