{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Editor (Debug x64)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/x64/Debug/Editor.exe",
      "args": [],
      "cwd": "${workspaceFolder}/bin/x64/Debug",
      "preLaunchTask": "Build: Editor (Debug x64)",
      "stopOnEntry": false,
      "env": {
        "PATH": "${env:VULKAN_SDK}\\Bin;${env:PATH}"
      },
      "initCommands": [
        "settings append target.exec-search-paths ${workspaceFolder}/bin/x64/Debug"
      ]
