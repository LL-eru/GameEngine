{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Full Solution",
      "type": "process",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/msbuild.ps1",
        "-Configuration",
        "Debug",
        "-Platform",
        "x64"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
